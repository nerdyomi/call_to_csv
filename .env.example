# Copy to .env and fill in. .env is git-ignored.
GEMINI_API_KEY=
# Optional extra keys, used in order when the previous one is out of quota. Use keys from DIFFERENT Google projects.
# GEMINI_API_KEY_2=
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash
# Any model id your key can use. Free tier: a Flash model.
GEMINI_MODEL=gemini-3.8-flash

# Optional overrides of config/settings.yaml
# PIPELINE_WORKERS=2
# PIPELINE_RPM=8
