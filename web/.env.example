# Copy to .env.local for local work. On Vercel add the same names under Project -> Settings -> Environment Variables.
# Never commit real values.

# Supabase -> Project Settings -> API  (use the project root URL, e.g. https://abcd.supabase.co  - NOT ending in /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq (chat + behaviour analysis). Models are tried in this order when one is rate-limited.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
